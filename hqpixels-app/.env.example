# Optional: manual mode works with these unset. Keep secrets on the server.
GEMINI_API_KEY=
GEMINI_TASK_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# PostgreSQL is REQUIRED in production. Local development uses data/hqpixels.sqlite.
DATABASE_URL=
PORT=3000
HOST=127.0.0.1
# Set NODE_ENV=production, HOST=0.0.0.0 and APP_ORIGIN to your HTTPS URL on Replit.
APP_ORIGIN=http://localhost:3000
AI_DAILY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=300
